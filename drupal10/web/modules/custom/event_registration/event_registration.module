<?php

use Drupal\Core\Form\FormBase;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_menu() to add admin page (Drupal 8/9/10 uses routes, but for simplicity we do this in module file).
 */
function event_registration_menu() {
  $items['admin/content/event-registration'] = [
    'title' => 'Event Registration',
    'description' => 'Manage events',
    'page callback' => 'drupal_get_form',
    'page arguments' => ['\Drupal\event_registration\Form\EventForm'],
    'access arguments' => ['administer site configuration'],
    'type' => MENU_NORMAL_ITEM,
  ];
  return $items;
}
